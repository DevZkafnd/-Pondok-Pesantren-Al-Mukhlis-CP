---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Logo dan Info -->
      <div class="footer-section">
        <div class="footer-brand">
          <img
            src="/logo-64.png"
            alt="Logo Pondok Pesantren Al-Mukhlis"
            class="logo-circle"
            width="48"
            height="48"
          />
          <div>
            <div class="footer-title">Pondok Pesantren Al-Mukhlis</div>
            <div class="footer-subtitle">Panyaungan, Bandung</div>
          </div>
        </div>
        <p class="footer-text">
          Lembaga pendidikan Islam yang menyelenggarakan program pendidikan agama dan umum
          dengan landasan nilai-nilai Islami.
        </p>
      </div>

      <!-- Navigasi -->
      <div class="footer-section">
        <h3 class="footer-heading">Navigasi</h3>
        <ul class="footer-links">
          <li><a href="/">Beranda</a></li>
          <li><a href="/profil">Profil Pesantren</a></li>
          <li><a href="/program">Program Pendidikan</a></li>
          <li><a href="/berita">Agenda & Berita</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>

      <!-- Kontak -->
      <div class="footer-section">
        <h3 class="footer-heading">Kontak</h3>
        <ul class="footer-contact">
          <li>
            <strong>Alamat:</strong><br />
            Panyaungan, Bandung<br />
            Jawa Barat, Indonesia
          </li>
          <li>
            <strong>Email:</strong><br />
            <a href="mailto:info@almukhlis.ac.id">info@almukhlis.ac.id</a>
          </li>
          <li>
            <strong>Telepon:</strong><br />
            <span class="text-note">(Akan diperbarui)</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} Pondok Pesantren Al-Mukhlis. Seluruh hak cipta dilindungi.
      </p>
      <p class="footer-note">
        <em>Catatan: Ini adalah konten contoh untuk pengembangan. Data akan diperbarui oleh pengelola pesantren.</em>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-neutral-charcoal);
    color: var(--color-neutral-gray-200);
    padding: 3rem 0 1.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .footer-title {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-neutral-white);
  }

  .footer-subtitle {
    font-size: 0.875rem;
    color: var(--color-neutral-gray-300);
  }

  .footer-text {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-neutral-white);
    margin: 0 0 0.75rem 0;
  }

  .footer-links,
  .footer-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a,
  .footer-contact a {
    color: var(--color-neutral-gray-300);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: var(--color-brand-primary-light);
  }

  .footer-contact li {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .footer-contact strong {
    color: var(--color-neutral-white);
  }

  .text-note {
    color: var(--color-neutral-gray-300);
    font-style: italic;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-neutral-charcoal-light);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .footer-copyright,
  .footer-note {
    font-size: 0.813rem;
    margin: 0;
  }

  .footer-note {
    color: var(--color-neutral-gray-300);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
  }
</style>
