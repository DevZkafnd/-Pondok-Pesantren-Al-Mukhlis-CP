---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="Kontak - Pondok Pesantren Al-Mukhlis"
  description="Hubungi kami untuk informasi lebih lanjut tentang Pondok Pesantren Al-Mukhlis."
>
  <Header />
  
  <main id="main-content">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">Hubungi Kami</h1>
        <p class="page-subtitle">
          Kami siap membantu Anda dengan informasi yang dibutuhkan
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="content-grid">
          <div class="content-box">
            <p class="notice">
              <strong>Catatan:</strong> Ini adalah halaman placeholder. Informasi kontak lengkap, 
              peta lokasi, dan formulir kontak akan diisi oleh pengelola melalui CMS Strapi.
            </p>
            
            <h2>Alamat</h2>
            <p>
              Panyaungan, Bandung<br />
              Jawa Barat, Indonesia
            </p>
            
            <h2>Kontak</h2>
            <p>
              <strong>Email:</strong> info@almukhlis.ac.id<br />
              <strong>Telepon:</strong> (Akan diperbarui)<br />
              <strong>WhatsApp:</strong> (Akan diperbarui)
            </p>
            
            <h2>Jam Operasional</h2>
            <p>
              Senin - Jumat: 08.00 - 16.00 WIB<br />
              Sabtu: 08.00 - 12.00 WIB<br />
              Minggu & Libur: Tutup
            </p>
          </div>
          
          <div class="map-placeholder">
            <svg width="100%" height="100%" viewBox="0 0 400 400">
              <rect width="400" height="400" fill="var(--color-neutral-cream)" />
              <text x="50%" y="50%" text-anchor="middle" fill="var(--color-neutral-gray-700)" font-size="18">
                Peta Lokasi
              </text>
              <text x="50%" y="55%" text-anchor="middle" fill="var(--color-neutral-gray-700)" font-size="14">
                (Akan ditambahkan Google Maps)
              </text>
            </svg>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, var(--color-brand-primary-dark) 100%);
    color: var(--color-neutral-white);
    padding: 3rem 0;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.75rem 0;
  }

  .page-subtitle {
    font-size: 1.125rem;
    margin: 0;
    opacity: 0.95;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .content-box h2 {
    color: var(--color-brand-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .content-box h2:first-of-type {
    margin-top: 0;
  }

  .notice {
    background-color: var(--color-neutral-cream);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-brand-gold);
    margin-bottom: 2rem;
  }

  .map-placeholder {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    min-height: 400px;
  }
</style>
